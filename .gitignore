.env.local
.env.*.local

# ── Jupyter ────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ── Data / Models / Outputs (large, git-ignored) ───────
# Keep small sample CSVs under data/samples/ (force-added).
# Everything else ignored by default.
data/raw/
data/processed/
data/external/
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.bin
*.onnx
*.ckpt
models/
checkpoints/
runs/
mlruns/
*.log
outputs/

# Allow tracked samples explicitly (negation works with git add -f anyway)
!data/samples/.gitkeep
!data/samples/README.md

# ── OS / Editor ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
