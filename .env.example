# Copy this file to `.env` and fill in your own keys.
# NEVER commit `.env` — it is git-ignored. Only `.env.example` is tracked.
#
# Usage:
#   cp .env.example .env
#   # edit .env, then:
#   python -c "import dotenv; print('ok')"  # optional check

# ── LLM providers (only set the ones you use) ──────────
OPENAI_API_KEY=sk-...-here
ANTHROPIC_API_KEY=sk-ant-...-here
COHERE_API_KEY=...-here
HUGGINGFACE_HUB_TOKEN=hf_...-here

# ── Vector DBs ─────────────────────────────────────────
PINECONE_API_KEY=...-here
PINECONE_ENVIRONMENT=us-east-1-aws

# ── Search / tools ─────────────────────────────────────
SERPER_API_KEY=...-here
TAVILY_API_KEY=...-here

# ── App config ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
MODEL_CACHE_DIR=./models
DATA_DIR=./data
